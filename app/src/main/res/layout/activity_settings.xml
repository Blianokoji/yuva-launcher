<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:padding="48dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            android:textSize="28sp"
            android:textColor="@color/text_primary"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_wallpaper_gallery"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="From Downloads / Pictures"
                android:textColor="@color/text_primary"
                android:background="@drawable/tile_selector"
                android:padding="16dp"
                android:layout_marginEnd="16dp" />

            <Button
                android:id="@+id/btn_wallpaper"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pick_wallpaper"
                android:textColor="@color/text_primary"
                android:background="@drawable/tile_selector"
                android:padding="16dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tile_size"
            android:textColor="@color/text_muted"
            android:paddingTop="24dp" />

        <SeekBar
            android:id="@+id/seek_tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/anim_speed"
            android:textColor="@color/text_muted"
            android:paddingTop="16dp" />

        <SeekBar
            android:id="@+id/seek_anim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50" />

        <TextView
            android:id="@+id/hidden_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hidden_apps"
            android:textColor="@color/text_muted"
            android:paddingTop="24dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hidden_list"
            android:layout_width="match_parent"
            android:layout_height="320dp" />
    </LinearLayout>
</ScrollView>
